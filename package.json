{
  "name": "sparkle-carpets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sparkle-carpets --local",
    "db:migrate:remote": "wrangler d1 migrations apply sparkle-carpets --remote",
    "build:node": "vite build --config vite.node.config.ts && vite build --config vite.server.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/server.js",
    "migrate:node": "node --disable-warning=ExperimentalWarning dist/server/server.js --migrate"
  },
  "dependencies": {
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@tailwindcss/vite": "^4.1.11",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.21.0",
    "@types/node": "^22.15.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
