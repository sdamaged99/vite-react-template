# Copy to .dev.vars for local development. Never commit .dev.vars.
# On the server these live in /etc/sparkle-carpets/env (see SELF_HOSTING.md).

# Addresses that can sign in to /admin/ by emailed code, comma-separated.
# Unset = admin API fail-closed (503).
ADMIN_EMAILS=""

# Email via the business's own NethServer over authenticated SMTP.
# With any of these unset, enquiries are stored but no email is attempted.
SMTP_HOST=""
SMTP_PORT=""      # 465 (implicit TLS) or 587 (STARTTLS)
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""      # e.g. Sparkle Carpets <website@sparklecarpets.im>
MAIL_TO=""        # e.g. bookings@sparklecarpets.im

# Cloudflare Turnstile (enquiry form). Unset = verification skipped.
TURNSTILE_SECRET_KEY=""
