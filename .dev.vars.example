ACCESS_TEAM_DOMAIN=""
ACCESS_AUD=""

# Transactional email (Phase 3) — e.g. Resend API key
EMAIL_API_KEY=""

# Cloudflare Turnstile (Phase 2 booking form)
TURNSTILE_SECRET_KEY=""
