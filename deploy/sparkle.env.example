# /etc/sparkle/sparkle.env  (chmod 640, root:sparkle)
PORT=8787
HOST=0.0.0.0
DB_PATH=/srv/sparkle/data/sparkle.db

# Cloudflare Access (same values as the Worker had). Admin is refused if blank.
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ACCESS_AUD=

# Mail (NethServer). Port 465 = implicit TLS, anything else = STARTTLS.
SMTP_HOST=mail.example.im
SMTP_PORT=587
SMTP_USER=website@sparklecarpets.im
SMTP_PASS=
MAIL_FROM=Sparkle Carpets <website@sparklecarpets.im>
MAIL_TO=bookings@sparklecarpets.im
# Only if the mail server's certificate is from a private CA:
# SMTP_CA_FILE=/etc/sparkle/mail-ca.pem

# Optional
# TURNSTILE_SECRET_KEY=
