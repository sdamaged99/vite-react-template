# Copy to /etc/sparkle-carpets/env, owner root:sparkle, mode 640.
DATABASE_PATH=/var/lib/sparkle-carpets/sparkle.db
APP_DIR=/opt/sparkle-carpets
# Nginx Proxy Manager is on another machine, so listen beyond localhost.
HOST=0.0.0.0
PORT=8787

# Port 587 (STARTTLS) is the tested path.
SMTP_HOST=mail.demanufactured.co.uk
SMTP_PORT=587
SMTP_USER=website@sparklecarpets.im
SMTP_PASS=
MAIL_FROM=Sparkle Carpets <website@sparklecarpets.im>
MAIL_TO=bookings@sparklecarpets.im

# Comma-separated addresses that can sign in to /admin/ by emailed code.
# Unset = admin stays closed. Mail must be configured for codes to arrive.
ADMIN_EMAILS=

# Optional. Also needs TURNSTILE_SITE_KEY in src/main.ts.
TURNSTILE_SECRET_KEY=
