{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tsbuild/node",
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["server", "worker", "shared"]
}
