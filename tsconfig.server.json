{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tsbuild/server",
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["server", "worker", "shared"]
}
